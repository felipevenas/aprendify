# Aprendify — frontend environment template
# Copy this file to .env.local and fill in your own Supabase project values.
#
# Vite exposes only variables prefixed with VITE_* to the browser bundle.
# Never place service-role keys, Stripe secrets, Groq keys, or reCAPTCHA
# secrets in this file. Server-side secrets belong to Supabase Edge Functions.

# Supabase project URL (public)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable (anon) key (public)
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
